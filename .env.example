PORT=4100
# Coolify: JANGAN pakai tanda kutip. Kalau password ada karakter $, tulis $$ (escape).
# Pakai encrypt=DANGER_PLAINTEXT (bukan encrypt=true) untuk SQL Server AMS.
DATABASE_URL=sqlserver://103.227.145.122:1433;database=lelang;user=sa;password=YOUR_PASSWORD;encrypt=DANGER_PLAINTEXT;trustServerCertificate=true
JWT_SECRET=change-me
OTP_SECRET=change-me-otp

DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Email: Brevo ATAU SMTP. Coolify production wajib salah satunya.
# Dev tanpa provider: ALLOW_OTP_CONSOLE=1 (OTP hanya di log container).
#
# BREVO_FROM_EMAIL HARUS sender verified di Brevo dashboard.
# noreply@amscorp.co.id belum verified → API 201 tapi event=error, inbox kosong.
# Sender aktif saat ini: layarbaru1@gmail.com
BREVO_API_KEY=
BREVO_FROM_EMAIL=layarbaru1@gmail.com
BREVO_FROM_NAME=E-Lelang
ALLOW_OTP_CONSOLE=

# Fallback / alternatif (Gmail AMS — sama BirthdayEmailTemplate)
# EMAIL_PROVIDER=smtp  → paksa SMTP; default: Brevo jika BREVO_API_KEY ada
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_PROVIDER=brevo

EMPLOYEE_API_BASE_URL=https://golangapi-j5iu.onrender.com
EMPLOYEE_API_KEY=

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@amscorp.id
PUSH_WEBHOOK_SECRET=

# FE origins (comma-separated). Coolify: isi URL FE production, contoh:
# CORS_ORIGIN=https://lelang.amscorp.id,http://localhost:3000,http://localhost:3001
# Atau izinkan semua preview sslip: CORS_ORIGIN=*.sslip.io,http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
BACKUP_DIR=../lelang/backup/20260918-095630
